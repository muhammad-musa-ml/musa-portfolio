# Copy to .env.local for development; never commit real credentials.
# Configure these same server variables in Vercel, then redeploy.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b
MUSAI_PROVIDER_ORDER=groq

# Optional independent fallback, only after verifying a free-tier project.
# MUSAI_PROVIDER_ORDER=groq,gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Production event storage: a free Upstash Redis database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ANALYTICS_ADMIN_TOKEN=
ANALYTICS_SITE_ORIGIN=https://iammusa.vercel.app

# Private dashboard on this computer; this token must match Vercel's.
ANALYTICS_EXPORT_URL=https://iammusa.vercel.app/api/analytics-export

# Opt-in local testing only. Do not set these three on Vercel.
# VITE_ANALYTICS_LOCAL=true
# ANALYTICS_DEV_RECEIVER=http://127.0.0.1:5181
# LOCAL_ANALYTICS_ORIGIN=http://127.0.0.1:5174

# Kaiju runs at /kaiju/ with /api/kaiju/* on this same production deployment.
# No separate application URL or browser-exposed credential is needed.
